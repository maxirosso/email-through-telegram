generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EmailProviderKind {
  MICROSOFT
  GMAIL
}

enum AccountAccessMode {
  PRIMARY
  SHARED
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
  ERROR
  DISCONNECTED
}

enum DraftStatus {
  DRAFT
  READY
  SCHEDULED
  CANCELLED
  SENDING
  SENT
  FAILED
  UNKNOWN_SEND_STATUS
}

enum ReplyType {
  NEW
  REPLY
  REPLY_ALL
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model ApplicationUser {
  id                String                @id @default(cuid())
  authUserId        String?               @unique @db.Uuid
  email             String?               @unique
  displayName       String?
  isPlatformAdmin   Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  accounts          EmailAccount[]
  destinations      TelegramDestination[]
  settings          ApplicationSettings?
  billing           BillingSubscription?
  usageCounters     UsageCounter[]
  auditEvents       AuditEvent[]
  alerts            AlertEvent[]
  supportCases      SupportCase[]
  telegramPairCodes TelegramPairingCode[]
}

model EmailAccount {
  id                    String            @id @default(cuid())
  userId                String
  provider              EmailProviderKind
  accessMode            AccountAccessMode @default(PRIMARY)
  emailAddress          String
  displayName           String?
  mailboxAddress        String?
  providerAccountId     String
  encryptedTokens       String
  enabled               Boolean           @default(true)
  notificationsOn       Boolean           @default(true)
  connectionStatus      ConnectionStatus  @default(CONNECTED)
  syncCursor            String?
  lastSyncedAt          DateTime?
  webhookSubscriptionId String?           @unique
  webhookExpiresAt      DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  ApplicationUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              EmailMessage[]
  drafts                EmailDraft[]
  syncCheckpoint        SyncCheckpoint?
  alerts                AlertEvent[]

  @@unique([provider, providerAccountId])
  @@unique([userId, emailAddress])
  @@index([userId, enabled])
  @@index([enabled, notificationsOn])
}

model EmailMessage {
  id                String                 @id @default(cuid())
  accountId         String
  providerMessageId String
  conversationId    String?
  internetMessageId String?
  senderName        String?
  senderAddress     String
  replyTo           Json?
  recipients        Json
  subject           String
  sanitizedPreview  String?
  receivedAt        DateTime
  providerWebLink   String?
  hasAttachments    Boolean                @default(false)
  createdAt         DateTime               @default(now())
  account           EmailAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  attachments       EmailAttachment[]
  drafts            EmailDraft[]
  deliveries        NotificationDelivery[]

  @@unique([accountId, providerMessageId])
  @@index([accountId, receivedAt(sort: Desc)])
}

model EmailAttachment {
  id                   String        @id @default(cuid())
  messageId            String?
  draftId              String?
  providerAttachmentId String?
  telegramFileId       String?
  filename             String
  mimeType             String
  sizeBytes            BigInt
  temporaryStorageKey  String?
  createdAt            DateTime      @default(now())
  message              EmailMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  draft                EmailDraft?   @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, telegramFileId])
  @@index([messageId])
}

model EmailDraft {
  id                String            @id @default(cuid())
  accountId         String
  originalMessageId String?
  providerDraftId   String
  replyType         ReplyType
  recipients        Json
  subject           String
  body              String
  status            DraftStatus       @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  account           EmailAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  originalMessage   EmailMessage?     @relation(fields: [originalMessageId], references: [id], onDelete: Restrict)
  attachments       EmailAttachment[]
  outgoing          OutgoingMessage?

  @@index([accountId, status])
  @@index([originalMessageId])
}

model OutgoingMessage {
  id                   String      @id @default(cuid())
  draftId              String      @unique
  status               DraftStatus @default(DRAFT)
  confirmedAt          DateTime?
  scheduledSendAt      DateTime?
  cancellationDeadline DateTime?
  claimedAt            DateTime?
  sentAt               DateTime?
  cancelledAt          DateTime?
  providerResponse     Json?
  errorDetails         String?
  attempts             Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  draft                EmailDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([status, scheduledSendAt])
}

model TelegramDestination {
  id             String                      @id @default(cuid())
  userId         String
  telegramUserId BigInt                      @unique
  chatId         BigInt                      @unique
  pairedAt       DateTime?
  enabled        Boolean                     @default(true)
  user           ApplicationUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  states         TelegramConversationState[]
  deliveries     NotificationDelivery[]

  @@index([userId])
}

model TelegramConversationState {
  id            String              @id @default(cuid())
  destinationId String
  activeDraftId String?
  expectedInput String?
  state         String
  updatedAt     DateTime            @updatedAt
  destination   TelegramDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, activeDraftId])
}

model TelegramProcessedUpdate {
  updateId  BigInt   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NotificationDelivery {
  id                String              @id @default(cuid())
  messageId         String
  destinationId     String
  status            DeliveryStatus      @default(PENDING)
  attempts          Int                 @default(0)
  telegramMessageId BigInt?
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  message           EmailMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  destination       TelegramDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([messageId, destinationId])
  @@index([destinationId])
}

model SyncCheckpoint {
  id             String       @id @default(cuid())
  accountId      String       @unique
  providerCursor String?
  lastSyncedAt   DateTime?
  errorState     String?
  account        EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model ApplicationSettings {
  id                        String          @id @default(cuid())
  userId                    String          @unique
  timezone                  String          @default("America/Buenos_Aires")
  undoSendSeconds           Int             @default(10)
  notificationPreviewLength Int             @default(2500)
  messageRetentionDays      Int             @default(90)
  auditRetentionDays        Int             @default(365)
  alertOnFailure            Boolean         @default(true)
  deletionRequestedAt       DateTime?
  user                      ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingSubscription {
  id                    String          @id @default(cuid())
  userId                String          @unique
  plan                  PlanTier        @default(FREE)
  status                BillingStatus   @default(ACTIVE)
  billingCustomerId     String?         @unique
  billingSubscriptionId String?         @unique
  currentPeriodStart    DateTime        @default(now())
  currentPeriodEnd      DateTime?
  monthlyMessageLimit   Int             @default(1000)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageCounter {
  id          String          @id @default(cuid())
  userId      String
  metric      String
  periodStart DateTime
  quantity    Int             @default(0)
  updatedAt   DateTime        @updatedAt
  user        ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric, periodStart])
  @@index([userId, periodStart(sort: Desc)])
}

model AuditEvent {
  id              String          @id @default(cuid())
  userId          String
  actorAuthUserId String?         @db.Uuid
  action          String
  entityType      String
  entityId        String?
  severity        AuditSeverity   @default(INFO)
  metadata        Json?
  createdAt       DateTime        @default(now())
  user            ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, severity, createdAt(sort: Desc)])
}

model AlertEvent {
  id              String          @id @default(cuid())
  userId          String
  accountId       String?
  dedupeKey       String
  kind            String
  title           String
  message         String
  status          AlertStatus     @default(OPEN)
  occurrenceCount Int             @default(1)
  firstSeenAt     DateTime        @default(now())
  lastSeenAt      DateTime        @default(now())
  lastNotifiedAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         EmailAccount?   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, status, lastSeenAt(sort: Desc)])
  @@index([accountId])
}

model SupportCase {
  id         String          @id @default(cuid())
  userId     String
  subject    String
  message    String
  status     SupportStatus   @default(OPEN)
  priority   String          @default("NORMAL")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  resolvedAt DateTime?
  user       ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)])
}

model TelegramPairingCode {
  id        String          @id @default(cuid())
  userId    String
  codeHash  String          @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())
  user      ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)])
}
